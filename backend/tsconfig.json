{
  "compilerOptions": {
    "types": ["node"],
    "moduleResolution": "node16",
    "module": "node16",
    "target": "ES2020",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true
  }
}